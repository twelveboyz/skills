{
  "groups": {
    "能修": "本机能处理，修完再重装",
    "要找人": "得别人动手，我们等或去问",
    "还没结论": "认不出的原文，只记录不下结论"
  },
  "rules": [
    {
      "type": "tmp_not_executable",
      "group": "能修",
      "disposition": "主机上 /tmp 或 /tmp/install.sh 不可执行",
      "suggest": "chmod 777 /tmp; chmod 777 /tmp/install.sh",
      "auto_fix": true,
      "fixable": true,
      "match": ["Permission denied", "/tmp"],
      "match_mode": "all",
      "scope": "installInfo"
    },
    {
      "type": "zbx_template_missing",
      "group": "要找人",
      "disposition": "资源池缺模板，联系监控中心给该资源池添加模板",
      "suggest": "联系监控中心给该资源池添加模板",
      "auto_fix": false,
      "fixable": false,
      "match": ["模板", "不存在", "资源池"],
      "match_mode": "all",
      "scope": "installInfo"
    },
    {
      "type": "proxy_port_unreachable",
      "group": "要找人",
      "disposition": "端口不通，确认对等连接是否建立",
      "suggest": "确认对等连接是否建立",
      "auto_fix": false,
      "fixable": false,
      "match": ["端口", "连接", "网络不通"],
      "match_mode": "any",
      "scope": "installInfo"
    }
  ]
}
